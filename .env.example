DB_URL=jdbc:postgresql://localhost:5432/novforge
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Google Cloud Console OAuth 2.0 Web client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# At least 32 random characters; use a different value in production.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION=3600

# Comma-separated Google account emails allowed to use administrator APIs.
ADMIN_EMAILS=admin@example.com
